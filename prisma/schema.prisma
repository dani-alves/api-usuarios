generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  idade    Int
  telefone String
  senha    String
  fotoPerfil String?  
  role     String  @default("user")
}

